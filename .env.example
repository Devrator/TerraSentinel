# TerraSentinel - Production Environment Configuration

# Backend API Configuration
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:5173

# Database Connection
# SQLite (Default lightweight embedded)
DATABASE_URL=sqlite:///./environment_monitoring.db
# PostgreSQL (Enterprise Production Alternative)
# DATABASE_URL=postgresql://terrasentinel_user:secure_password@postgres:5432/terrasentinel_db

# Simulation & Telemetry Stream Cadence
SIMULATION_INTERVAL_SEC=15
EDGE_CALIBRATION_STANDARD=SIH26178_XAI_V2

# Frontend Ingestion API Endpoint
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
